# Dedicated Neon database. In Vercel this will come from the connected Neon Marketplace resource.
DATABASE_URL=

# INPI / RNE — optional official supplemental source.
# Username is the INPI account email used for the RNE API login.
INPI_USERNAME=
INPI_PASSWORD=

# Optional commercial providers. The engine works without them.
APILAYER_API_KEY=
HUNTER_API_KEY=

# Public origin used in source metadata / future webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
