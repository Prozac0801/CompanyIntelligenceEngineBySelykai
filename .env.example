# Dedicated Neon database. In Vercel this will come from the connected Neon Marketplace resource.
DATABASE_URL=

# Managed Neon Auth. Copy the Auth URL from Neon and generate a secret >= 32 characters.
# The engine also accepts the Vercel-generated alias:
# CompanyIntelligenceEngine_NEON_AUTH_BASE_URL
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# INPI / RNE — official supplemental source.
# Username is the INPI account email used for the RNE API login.
INPI_USERNAME=
INPI_PASSWORD=

# Commercial providers. Keys are server-side only.
APILAYER_API_KEY=
HUNTER_API_KEY=

# Internal monitoring worker. Generate a long random value and keep it server-side only.
CRON_SECRET=
MONITOR_BATCH_SIZE=20

# Public origin used in source metadata / future webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
